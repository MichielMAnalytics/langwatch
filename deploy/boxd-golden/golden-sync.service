[Unit]
Description=Sync the boxd VM's tracked branch and run boxd-deploy.sh
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=boxd
WorkingDirectory=/home/boxd/langwatch
ExecStart=/home/boxd/langwatch/scripts/golden-sync.sh
# Don't fail-loud the timer when the script exits non-zero (e.g. transient
# network blip on git fetch). Next tick retries.
SuccessExitStatus=0 1
