[Unit]
Description=GitHub webhook receiver for golden-sync
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=boxd
ExecStart=/usr/bin/webhook \
  -hooks /etc/golden-webhook.conf.json \
  -port 9090 \
  -ip 0.0.0.0 \
  -verbose
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
